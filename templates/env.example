# Copy to data/.env. Only unattended runs need it. customer-signals needs no API keys.

# The agent CLI that writes notes and matches signals when no one is at the keyboard.
# The engine appends the prompt as the last argument. Pick the one you use:
# CS_AGENT_CMD=claude -p --model sonnet
# CS_AGENT_CMD=codex exec
# CS_AGENT_CMD=gemini -p
